<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AM26_E_1_Kosci.MainPage"
             BackgroundColor="#F5F5DC"
             WidthRequest="540"
             HeightRequest="960">

    <ScrollView>
        <VerticalStackLayout
            Padding="0"
            Margin="0,20"
            Spacing="25">
            <Label Text="Gra w kości. Autor 21376769"
                   BackgroundColor="#A52A2A"
                   TextColor="White"
                   Padding="5"
                   HeightRequest="60"
                   FontSize="30"
                   VerticalTextAlignment="Center">
            </Label>
            <Button x:Name="RollButton"
                    BackgroundColor="#D2691E"
                    Text="RZUĆ KOŚCMI"
                    Clicked="RollButton_Clicked"
                    HeightRequest="60">
            </Button>
            <HorizontalStackLayout x:Name="DicesStack"
                                   Padding="0"
                                   Margin="0"
                                   HeightRequest="100"
                                   BackgroundColor="White"
                                   HorizontalOptions="Center">
            </HorizontalStackLayout>
            <Label x:Name="RollScoreLabel"
                   Text="Wynik tego losowania: 0"
                   HeightRequest="40"
                   HorizontalTextAlignment="Center">
            </Label>
            <Label x:Name="GameScoreLabel"
                   Text="Wynik gry: 0"
                   HeightRequest="40"
                   HorizontalTextAlignment="Center">
            </Label>
            <Button x:Name="ResetButton"
                    BackgroundColor="#D2691E"
                    Text="RESETUJ WYNIK"
                    Clicked="ResetButton_Clicked"
                    HeightRequest="60">
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
